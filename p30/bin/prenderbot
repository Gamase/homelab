#!/data/data/com.termux/files/usr/bin/bash
set -uo pipefail

SESSION="discord-bot"
DIR="$HOME/discord-bot"
PATRON="$DIR/venv/bin/python -u main.py"

if ! command -v tmux >/dev/null 2>&1; then
    echo "❌ tmux no está instalado."
    exit 1
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
    if pgrep -f "$PATRON" >/dev/null 2>&1; then
        echo "✅ El bot ya está encendido (sesión tmux: $SESSION)."
        exit 0
    fi
    echo "⚠️  Sesión $SESSION colgada; reiniciando..."
    tmux kill-session -t "$SESSION" 2>/dev/null
fi

tmux new-session -d -s "$SESSION" "$DIR/run.sh"
sleep 2

if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "🚀 Bot encendido (sesión tmux: $SESSION)."
    echo "   Log: $DIR/bot.log"
    echo "   Ver en vivo: tmux attach -t $SESSION"
else
    echo "❌ No se pudo iniciar el bot. Revisa $DIR/bot.log"
    exit 1
fi
