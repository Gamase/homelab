#!/data/data/com.termux/files/usr/bin/python
import os
import socket

# La MAC de la PC vive en ~/.config/homelab/red.env (PC_MAC=...), fuera del repo
def leer_env(ruta):
    datos = {}
    with open(ruta) as f:
        for linea in f:
            linea = linea.strip()
            if linea and not linea.startswith("#") and "=" in linea:
                clave, valor = linea.split("=", 1)
                datos[clave.strip()] = valor.strip().strip('"').strip("'")
    return datos

MAC = leer_env(os.path.expanduser("~/.config/homelab/red.env"))["PC_MAC"]
BROADCAST = "192.168.100.255"    # broadcast de tu red de casa

mac = bytes.fromhex(MAC.replace("-", "").replace(":", ""))
paquete = b"\xff" * 6 + mac * 16

with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    for puerto in (7, 9):
        s.sendto(paquete, (BROADCAST, puerto))

print("Paquete mágico enviado a", MAC)
